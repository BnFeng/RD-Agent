# RD-Agent 本地开发环境模板
# 适用场景：本机 conda 运行，暂不使用 Docker。
# 使用方式：复制为 .env 后填写真实值，或直接编辑项目根目录下的 .env。
# 注意：请通过 `dotenv run -- <命令>` 启动，这样 .env 中的变量才会被注入进程环境。
# 说明：下面额外补充了 Prediction Market 监控项目预留变量。
#      这些 `POLYMARKET_*` / `OPINION_*` 变量不会被 RD-Agent 核心直接消费，
#      但后续你要做的监控采集服务可以直接复用这一份 `.env`。

# =========================
# 全局基础配置
# =========================
BACKEND=rdagent.oai.backend.LiteLLMAPIBackend
MAX_RETRY=10
RETRY_WAIT_SECONDS=20
MULTI_PROC_N=1
STEP_SEMAPHORE=1

# =========================
# 缓存与工作区
# =========================
USE_CHAT_CACHE=True
DUMP_CHAT_CACHE=True
USE_EMBEDDING_CACHE=True
DUMP_EMBEDDING_CACHE=True
LOG_LLM_CHAT_CONTENT=True
PROMPT_CACHE_PATH=/root/Ai-polyTest/RD-Agent/git_ignore_folder/prompt_cache.db
WORKSPACE_PATH=/root/Ai-polyTest/RD-Agent/git_ignore_folder/RD-Agent_workspace
PICKLE_CACHE_FOLDER_PATH_STR=/root/Ai-polyTest/RD-Agent/pickle_cache

# =========================
# LLM：当前默认使用的主配置
# 说明：如果你的网关兼容 OpenAI / LiteLLM，这一组通常就够用。
# =========================
CHAT_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_BASE=https://your-llm-proxy.example.com/v1
OPENAI_API_KEY=REPLACE_ME
CHAT_TEMPERATURE=0.2
CHAT_STREAM=True
REASONING_THINK_RM=True

# =========================
# LLM：OpenAI GPT-5.4 官方直连接口模板
# 说明：截至 2026-03-12，OpenAI 官方模型目录中可见 `gpt-5.4`。
# 用法：如果你准备用官方或兼容官方的接口，直接把上面的主配置改成下面这组即可。
# =========================
# CHAT_MODEL=gpt-5.4
# EMBEDDING_MODEL=text-embedding-3-large
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_API_KEY=REPLACE_ME
# REASONING_EFFORT=medium
# CHAT_TEMPERATURE=0.2
# CHAT_STREAM=True

# =========================
# LLM：独立 embedding 服务（按需启用）
# 说明：如果聊天 API 不支持 embedding，保留上面的聊天配置，
#      再取消下面三行注释并填写你自己的 embedding 服务。
# =========================
# EMBEDDING_MODEL=litellm_proxy/BAAI/bge-large-en-v1.5
# LITELLM_PROXY_API_BASE=https://api.siliconflow.cn/v1
# LITELLM_PROXY_API_KEY=REPLACE_ME

# =========================
# 本地执行模式
# 说明：这些开关会把主要运行环境切到本地 conda，而不是 Docker。
# =========================
DS_CODER_COSTEER_ENV_TYPE=conda
MODEL_COSTEER_ENV_TYPE=conda
FT_CODER_COSTEER_ENV_TYPE=conda

# =========================
# Data Science 场景默认配置
# 说明：这是更适合本地自定义数据集的默认值，不走 Kaggle 模式。
# =========================
DS_SCEN=rdagent.scenarios.data_science.scen.DataScienceScen
DS_LOCAL_DATA_PATH=/root/Ai-polyTest/RD-Agent/git_ignore_folder/ds_data
DS_CODER_ON_WHOLE_PIPELINE=True
DS_IF_USING_MLE_DATA=False
DS_SAMPLE_DATA_BY_LLM=False

# =========================
# LLM Fine-tuning 场景工作目录
# =========================
FT_FILE_PATH=/root/Ai-polyTest/RD-Agent/git_ignore_folder/ft_workspace

# =========================
# Prediction Market：Polymarket 监控配置
# 说明：Gamma / Data / Market WSS 可做公开市场监控；
#      User WSS 与交易接口需要 API 凭证。
# =========================
POLYMARKET_GAMMA_BASE=https://gamma-api.polymarket.com
POLYMARKET_DATA_API_BASE=https://data-api.polymarket.com
POLYMARKET_CLOB_BASE=https://clob.polymarket.com
POLYMARKET_WSS_MARKET=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_WSS_USER=wss://ws-subscriptions-clob.polymarket.com/ws/user
POLYMARKET_WSS_SPORTS=wss://sports-api.polymarket.com/ws
POLYMARKET_WSS_PING_INTERVAL_SEC=10
POLYMARKET_CUSTOM_FEATURE_ENABLED=True
POLYMARKET_CHAIN_ID=137

# Polymarket：公开监控通常不用填下面几项；
# 如果你后续要订阅 user channel、查账户、挂单撤单，再填写。
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_SIGNATURE_TYPE=

# =========================
# Prediction Market：Opinion 监控配置
# 说明：Opinion 的 OpenAPI、WebSocket、CLOB SDK 共用同一个 API Key。
#      WebSocket 鉴权方式：wss://ws.opinion.trade?apikey={API_KEY}
# =========================
OPINION_OPENAPI_BASE=https://openapi.opinion.trade/openapi
OPINION_WSS_BASE=wss://ws.opinion.trade
OPINION_API_KEY=
OPINION_WSS_HEARTBEAT_INTERVAL_SEC=30
OPINION_DEFAULT_MARKET_STATUS=activated
OPINION_DEFAULT_MARKET_TYPE=2
OPINION_DEFAULT_PAGE_SIZE=20

# Opinion：如果后续要接 CLOB SDK / 链上交易，再补下面几项
OPINION_PROXY_HOST=https://proxy.opinion.trade:8443
OPINION_CHAIN_ID=56
OPINION_RPC_URL=https://bsc-dataseed.binance.org
OPINION_PRIVATE_KEY=
OPINION_MULTI_SIG_ADDR=
OPINION_CONDITIONAL_TOKENS_ADDR=
OPINION_MULTISEND_ADDR=

# =========================
# Prediction Market：SX.Bet 监控配置
# 说明：公开 REST 可直接抓取 metadata / markets / orders；
#      实时通道基于 Ably，需要先用 X-Api-Key 请求 /user/token。
# =========================
SX_BET_APP_URL=https://sx.bet
SX_BET_API_BASE=https://api.sx.bet
SX_BET_METADATA_URL=https://api.sx.bet/metadata
SX_BET_USER_TOKEN_URL=https://api.sx.bet/user/token
SX_BET_RPC_URL=https://rpc-rollup.sx.technology
SX_BET_EXPLORER_URL=https://explorerl2.sx.technology
SX_BET_CHAIN_ID=4162
SX_BET_USDC_TOKEN_ADDRESS=0x6629Ce1Cf35Cc1329ebB4F63202F3f197b3F050B
SX_BET_WSX_TOKEN_ADDRESS=0x3E96B0a25d51e3Cc89C557f152797c33B839968f
SX_BET_API_KEY=
SX_BET_ONLY_MAIN_LINE=True
SX_BET_POLL_INTERVAL_SEC=15

# =========================
# Prediction Market：监控频率与限流控制
# 说明：优先使用 WebSocket；REST 仅用于初始化目录、低频校准、断线后补同步。
#      如果你希望尽量纯 WS 运行，可把 CATALOG_REFRESH_INTERVAL_SEC 设为 0。
# =========================
CATALOG_REFRESH_INTERVAL_SEC=300
HTTP_TIMEOUT_SEC=20
HTTP_MAX_ATTEMPTS=5
HTTP_BACKOFF_BASE_SEC=1
HTTP_BACKOFF_MAX_SEC=60
POLYMARKET_HTTP_RATE_PER_SEC=3
OPINION_HTTP_RATE_PER_SEC=5
SX_BET_HTTP_RATE_PER_SEC=1
SX_BET_ENABLE_ORDERBOOK_CHANNELS=True
SX_BET_ENABLE_TRADE_CHANNELS=True

# =========================
# 可选：Azure OpenAI 示例
# =========================
# AZURE_API_KEY=REPLACE_ME
# AZURE_API_BASE=https://your-azure-endpoint.openai.azure.com/
# AZURE_API_VERSION=2024-10-21
# CHAT_MODEL=azure/your-chat-deployment
# EMBEDDING_MODEL=azure/your-embedding-deployment

# =========================
# 可选：DeepSeek 示例
# =========================
# DEEPSEEK_API_KEY=REPLACE_ME
# CHAT_MODEL=deepseek/deepseek-chat
# EMBEDDING_MODEL=litellm_proxy/BAAI/bge-m3
# LITELLM_PROXY_API_BASE=https://api.siliconflow.cn/v1
# LITELLM_PROXY_API_KEY=REPLACE_ME

# =========================
# 可选：Kaggle 场景补充项
# =========================
# KG_COMPETITION=
# KAGGLE_CONFIG_DIR=/root/.config/kaggle
